<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.agentplatform</groupId>
        <artifactId>agent-platform</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>orchestrator</artifactId>
    <packaging>jar</packaging>
    <name>orchestrator</name>
    <description>Agent orchestration and business logic</description>

    <dependencies>
        <!-- logging provides LoggingContext (MDC runId) + PiiSanitizer (redaction) -->
        <dependency>
            <groupId>com.agentplatform</groupId>
            <artifactId>logging</artifactId>
        </dependency>

        <!-- agent-core provides ChatModel bean -->
        <dependency>
            <groupId>com.agentplatform</groupId>
            <artifactId>agent-core</artifactId>
        </dependency>

        <!-- memory-service provides ConversationStore / InMemoryConversationStore -->
        <dependency>
            <groupId>com.agentplatform</groupId>
            <artifactId>memory-service</artifactId>
        </dependency>

        <!-- tool-service provides @Tool beans + DefaultToolExecutor for agent tool-calling -->
        <dependency>
            <groupId>com.agentplatform</groupId>
            <artifactId>tool-service</artifactId>
        </dependency>

        <!-- Spring Web for @RestController / @RequestMapping in JobApplicationController.
             This also supplies spring-boot-starter transitively, so no separate
             starter declaration is needed. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- LangChain4j core: directly imported by the agent, chat, resume and gap
             services (ChatModel, ChatRequest, ToolSpecifications, AiMessage, ...).
             Declared explicitly so compilation does not rely on agent-core
             happening to bring it in transitively. Version from the root pom. -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
        </dependency>

        <!-- Spring Data JPA + Jakarta Persistence + Spring Transaction for
             entities, JPA repositories and @Transactional persistence services -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Apache PDFBox — resume parsing (PDF) -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
        </dependency>

        <!-- Apache POI — resume parsing (DOCX) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- H2 in-memory database for @DataJpaTest slice tests (test scope only) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>

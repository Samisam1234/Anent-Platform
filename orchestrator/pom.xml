<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.agentplatform</groupId>
        <artifactId>agent-platform</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>orchestrator</artifactId>
    <packaging>jar</packaging>
    <name>orchestrator</name>
    <description>Agent orchestration and business logic</description>

    <dependencies>
        <!-- agent-core provides ChatModel bean -->
        <dependency>
            <groupId>com.agentplatform</groupId>
            <artifactId>agent-core</artifactId>
        </dependency>

        <!-- memory-service provides ConversationStore / InMemoryConversationStore -->
        <dependency>
            <groupId>com.agentplatform</groupId>
            <artifactId>memory-service</artifactId>
        </dependency>

        <!-- tool-service provides @Tool beans + DefaultToolExecutor for agent tool-calling -->
        <dependency>
            <groupId>com.agentplatform</groupId>
            <artifactId>tool-service</artifactId>
        </dependency>

        <!-- Spring Context for @Service -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Spring Web for @RestController / @RequestMapping in JobApplicationController -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Data JPA + Jakarta Persistence + Spring Transaction for
             entities, JPA repositories and @Transactional persistence services -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Apache PDFBox — resume parsing (PDF) -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
        </dependency>

        <!-- Apache POI — resume parsing (DOCX) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>

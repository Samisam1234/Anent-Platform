<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.agentplatform</groupId>
        <artifactId>agent-platform</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>rag-service</artifactId>
    <packaging>jar</packaging>
    <name>rag-service</name>
    <description>Retrieval-augmented generation with pgvector (document ingestion, chunking, vector search, context assembly)</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Spring Data JPA for persistent document/chunk storage -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- LangChain4j core for EmbeddingModel -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
        </dependency>

        <!-- memory-service reuse: VectorUserType + PostgresVectorDialect / H2VectorDialect -->
        <dependency>
            <groupId>com.agentplatform</groupId>
            <artifactId>memory-service</artifactId>
        </dependency>

        <!-- agent-core reuse: the EmbeddingModel bean defined by OllamaConfig -->
        <dependency>
            <groupId>com.agentplatform</groupId>
            <artifactId>agent-core</artifactId>
        </dependency>

        <!-- PostgreSQL driver: deliberately NOT declared here because rag-service
             references no PostgreSQL classes directly. It still reaches the
             compile and test classpath transitively via
             memory-service -> pgvector -> postgresql, which is what the
             Testcontainers integration tests need at runtime. Declaring it again
             at a narrower scope would change nothing. -->

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers for pgvector integration tests. Versions come from the
             testcontainers-bom in the root pom's dependencyManagement. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
